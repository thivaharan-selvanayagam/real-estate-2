<%- include('../partials/header') %>

<div class="page-hero">
  <div class="page-hero-bg">
    <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1400&q=80" alt="Mortgage Calculator">
  </div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content"><h1>Mortgage Calculator</h1></div>
</div>

<section class="section bg-navy">
  <div class="container">
    <div class="section-header text-center mb-48">
      <span class="section-label" style="color:var(--gold-light);">Plan Your Purchase</span>
      <h2 style="color:var(--white);">Calculate Your Monthly Payment</h2>
    </div>
    <div class="calc-grid">
      <div class="calc-inputs">
        <div class="calc-field">
          <label class="calc-label">Home Price</label>
          <div class="calc-input-wrap">
            <span class="calc-prefix">$</span>
            <input type="number" id="homePrice" class="calc-input" value="350000" min="0">
          </div>
        </div>
        <div class="calc-field">
          <label class="calc-label">Down Payment</label>
          <div style="display:flex;gap:12px;">
            <div class="calc-input-wrap" style="flex:1;">
              <span class="calc-prefix">$</span>
              <input type="number" id="downPayment" class="calc-input" value="70000" min="0">
            </div>
            <div class="calc-input-wrap" style="width:100px;">
              <input type="number" id="downPct" class="calc-input" value="20" min="0" max="100" step="1">
              <span class="calc-suffix">%</span>
            </div>
          </div>
        </div>
        <div class="calc-field">
          <label class="calc-label">Loan Term</label>
          <select id="loanTerm" class="calc-input" style="padding-left:16px;">
            <option value="30">30 Years</option>
            <option value="20">20 Years</option>
            <option value="15">15 Years</option>
            <option value="10">10 Years</option>
          </select>
        </div>
        <div class="calc-field">
          <label class="calc-label">Interest Rate</label>
          <div class="calc-input-wrap">
            <input type="number" id="interestRate" class="calc-input" value="7.0" min="0" max="30" step="0.1">
            <span class="calc-suffix">%</span>
          </div>
          <input type="range" id="rateSlider" min="1" max="15" step="0.1" value="7.0" class="calc-slider">
        </div>
        <div class="calc-field">
          <label class="calc-label">Property Tax (Annual)</label>
          <div class="calc-input-wrap">
            <span class="calc-prefix">$</span>
            <input type="number" id="propTax" class="calc-input" value="4200" min="0">
          </div>
        </div>
        <div class="calc-field">
          <label class="calc-label">Home Insurance (Annual)</label>
          <div class="calc-input-wrap">
            <span class="calc-prefix">$</span>
            <input type="number" id="insurance" class="calc-input" value="1800" min="0">
          </div>
        </div>
        <div class="calc-field">
          <label class="calc-label">HOA Fees (Monthly)</label>
          <div class="calc-input-wrap">
            <span class="calc-prefix">$</span>
            <input type="number" id="hoa" class="calc-input" value="0" min="0">
          </div>
        </div>
      </div>

      <div class="calc-result">
        <div class="calc-result-label">Estimated Monthly Payment</div>
        <div class="calc-monthly" id="totalMonthly">$0</div>
        <div class="calc-monthly-label">per month</div>
        <div class="calc-breakdown">
          <div class="calc-breakdown-item"><span class="calc-breakdown-label">Principal & Interest</span><span class="calc-breakdown-val" id="piPayment">$0</span></div>
          <div class="calc-breakdown-item"><span class="calc-breakdown-label">Property Tax</span><span class="calc-breakdown-val" id="taxPayment">$0</span></div>
          <div class="calc-breakdown-item"><span class="calc-breakdown-label">Home Insurance</span><span class="calc-breakdown-val" id="insPayment">$0</span></div>
          <div class="calc-breakdown-item"><span class="calc-breakdown-label">HOA Fees</span><span class="calc-breakdown-val" id="hoaPayment">$0</span></div>
          <div class="calc-breakdown-item" style="border-bottom:none;padding-bottom:0;"><span class="calc-breakdown-label">Loan Amount</span><span class="calc-breakdown-val" id="loanAmount">$0</span></div>
        </div>
        <a href="/contact" class="btn btn-primary" style="width:100%;text-align:center;margin-top:32px;">Talk to Rajivan</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>

<script>
function fmt(n) { return '$' + Math.round(n).toLocaleString(); }

function calc() {
  const price = parseFloat(document.getElementById('homePrice').value) || 0;
  const down = parseFloat(document.getElementById('downPayment').value) || 0;
  const term = parseInt(document.getElementById('loanTerm').value) || 30;
  const rate = parseFloat(document.getElementById('interestRate').value) || 0;
  const tax = parseFloat(document.getElementById('propTax').value) || 0;
  const ins = parseFloat(document.getElementById('insurance').value) || 0;
  const hoa = parseFloat(document.getElementById('hoa').value) || 0;

  const loan = price - down;
  const monthlyRate = rate / 100 / 12;
  const n = term * 12;
  let pi = 0;
  if (monthlyRate > 0) {
    pi = loan * (monthlyRate * Math.pow(1 + monthlyRate, n)) / (Math.pow(1 + monthlyRate, n) - 1);
  } else {
    pi = loan / n;
  }
  const monthly = pi + tax/12 + ins/12 + hoa;

  document.getElementById('piPayment').textContent = fmt(pi);
  document.getElementById('taxPayment').textContent = fmt(tax/12);
  document.getElementById('insPayment').textContent = fmt(ins/12);
  document.getElementById('hoaPayment').textContent = fmt(hoa);
  document.getElementById('loanAmount').textContent = fmt(loan);
  document.getElementById('totalMonthly').textContent = fmt(monthly);
}

// Sync down payment % and $
document.getElementById('homePrice').addEventListener('input', () => {
  const price = parseFloat(document.getElementById('homePrice').value) || 0;
  const pct = parseFloat(document.getElementById('downPct').value) || 20;
  document.getElementById('downPayment').value = Math.round(price * pct / 100);
  calc();
});
document.getElementById('downPayment').addEventListener('input', () => {
  const price = parseFloat(document.getElementById('homePrice').value) || 1;
  const down = parseFloat(document.getElementById('downPayment').value) || 0;
  document.getElementById('downPct').value = Math.round(down / price * 100);
  calc();
});
document.getElementById('downPct').addEventListener('input', () => {
  const price = parseFloat(document.getElementById('homePrice').value) || 0;
  const pct = parseFloat(document.getElementById('downPct').value) || 0;
  document.getElementById('downPayment').value = Math.round(price * pct / 100);
  calc();
});
document.getElementById('rateSlider').addEventListener('input', e => {
  document.getElementById('interestRate').value = e.target.value;
  calc();
});
document.getElementById('interestRate').addEventListener('input', e => {
  document.getElementById('rateSlider').value = e.target.value;
  calc();
});
['loanTerm','propTax','insurance','hoa'].forEach(id => {
  document.getElementById(id).addEventListener('input', calc);
});
calc();
</script>
