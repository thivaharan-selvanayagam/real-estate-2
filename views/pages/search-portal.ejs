<%- include('../partials/header') %>

<div class="page-hero" style="height:350px;">
  <div class="page-hero-bg">
    <img src="https://images.unsplash.com/photo-1555774698-0b77e0d5fac6?w=1400&q=80" alt="Search Portal">
  </div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content">
    <h1>My Search Portal</h1>
    <p style="color:rgba(255,255,255,0.8);margin-top:12px;font-size:15px;">Save searches, track favorites, and get notified of new listings.</p>
  </div>
</div>

<section class="section bg-cream">
  <div class="container" style="max-width:600px;">
    <div style="background:var(--white);padding:48px;border-radius:8px;box-shadow:var(--shadow-md);text-align:center;">
      <div style="width:80px;height:80px;background:var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:32px;color:var(--navy);">
        <i class="fas fa-user-circle"></i>
      </div>
      <span class="section-label">Personal Account</span>
      <h2 style="margin-bottom:12px;">Access Your Portal</h2>
      <p style="color:var(--text-mid);margin-bottom:32px;">Sign in or create a free account to save searches, favorite listings, and receive personalized property alerts.</p>
      <div class="form-group">
        <input type="email" class="form-input" placeholder="Email address">
      </div>
      <div class="form-group">
        <input type="password" class="form-input" placeholder="Password">
      </div>
      <button class="btn btn-primary" style="width:100%;margin-bottom:16px;">Sign In</button>
      <div style="font-size:13px;color:var(--text-light);">Don't have an account? <a href="#" style="color:var(--gold);font-weight:600;">Register Free</a></div>
      <div style="margin:24px 0;display:flex;align-items:center;gap:16px;">
        <hr style="flex:1;border-color:var(--cream-dark);">
        <span style="font-size:12px;color:var(--text-light);text-transform:uppercase;letter-spacing:0.1em;">or</span>
        <hr style="flex:1;border-color:var(--cream-dark);">
      </div>
      <a href="/home-search" class="btn btn-outline" style="width:100%;">Browse All Listings</a>
    </div>
    <div style="text-align:center;margin-top:32px;">
      <p style="font-size:13px;color:var(--text-light);">Need help? <a href="/contact" style="color:var(--gold);">Contact Rajivan</a> for personalized assistance.</p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
