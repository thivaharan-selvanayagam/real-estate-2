<%- include('../partials/header') %>

<!-- PAGE HERO with address input -->
<div class="page-hero" style="height:500px;align-items:center;padding-top:70px;padding-bottom:0;">
  <div class="page-hero-bg">
    <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1400&q=80" alt="Home Valuation">
  </div>
  <div class="page-hero-overlay" style="background:linear-gradient(to bottom,rgba(13,27,42,0.6) 0%,rgba(13,27,42,0.8) 100%);"></div>
  <div class="page-hero-content" style="z-index:2;position:relative;">
    <span class="section-label" style="color:var(--gold-light);">Free Assessment</span>
    <h1>How Much Is Your Home Worth?</h1>
    <div style="margin-top:32px;max-width:600px;margin-left:auto;margin-right:auto;">
      <div class="valuation-steps">
        <div class="valuation-step active"><div class="step-circle">1</div><span class="step-label">Property Address</span></div>
        <div class="step-line"></div>
        <div class="valuation-step"><div class="step-circle">2</div><span class="step-label">Property Details</span></div>
        <div class="step-line"></div>
        <div class="valuation-step"><div class="step-circle">3</div><span class="step-label">Get Estimate</span></div>
      </div>
      <div class="valuation-address-bar">
        <i class="fas fa-map-marker-alt" style="color:var(--gold);margin-right:12px;"></i>
        <input type="text" id="valuationAddress" placeholder="Enter your property address..." style="flex:1;background:none;border:none;outline:none;font-family:var(--font-body);font-size:15px;color:var(--navy);">
        <button class="btn btn-primary" onclick="startValuation()">Continue</button>
      </div>
    </div>
  </div>
</div>

<!-- INFO CARDS -->
<section class="section bg-cream">
  <div class="container">
    <div class="info-cards-grid">
      <div class="info-card">
        <div class="info-card-icon"><i class="fas fa-home"></i></div>
        <h3>What Is a Home Valuation?</h3>
        <p>A home valuation determines the current market value of a residential property. It is crucial for real estate transactions, preventing excessive borrowing and financial losses. When getting a mortgage, the home acts as collateral.</p>
      </div>
      <div class="info-card">
        <div class="info-card-icon"><i class="fas fa-calculator"></i></div>
        <h3>How Is the Valuation Calculated?</h3>
        <p>The value of your home is calculated using a combination of factors including its location, age, size, condition, any improvements or renovations made, and recent sale prices of comparable homes in the neighborhood.</p>
      </div>
      <div class="info-card">
        <div class="info-card-icon"><i class="fas fa-chart-line"></i></div>
        <h3>How Accurate Is the Online Valuation?</h3>
        <p>Online home valuations provide a good starting point and offer a general estimate of your property's worth. However, for the most accurate valuation, consider scheduling an in-person appraisal or Comparative Market Analysis.</p>
      </div>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <div>
        <span class="section-label">Find Homes</span>
        <h2>Start Your Property Search</h2>
      </div>
      <a href="/home-search" class="btn btn-primary btn-lg">Search Homes</a>
    </div>
  </div>
</section>

<!-- HOW IS VALUATION PERFORMED -->
<section class="section">
  <div class="container">
    <div class="section-header text-center mb-48">
      <span class="section-label">Two Accurate Ways</span>
      <h2>How Is a Valuation Performed?</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;">
      <div>
        <div class="valuation-method-title"><span class="method-dot gold"></span>Market Analysis</div>
        <h4 style="margin:12px 0 8px;">Comparative Market Analysis</h4>
        <p style="color:var(--text-mid);line-height:1.8;">A Comparative Market Analysis (CMA) is a tool used by real estate agents to value a home. It evaluates similar homes that have recently sold in the same area and uses them to conduct a sales comparison. It then analyzes differences between it and the home being valued.</p>
      </div>
      <div>
        <div class="valuation-method-title"><span class="method-dot navy"></span>Professional Opinion</div>
        <h4 style="margin:12px 0 8px;">Appraisals</h4>
        <p style="color:var(--text-mid);line-height:1.8;">An appraisal is an unbiased valuation of a home based on a professional's opinion. They are usually what mortgage companies use for home purchases and refinances. A lender usually orders a home appraisal — the appraiser does a complete visual inspection of the interior and exterior of the home.</p>
      </div>
    </div>
  </div>
</section>

<!-- WHY IS VALUATION IMPORTANT -->
<section class="section bg-cream">
  <div class="container">
    <div class="section-header text-center mb-48">
      <span class="section-label">Why It Matters</span>
      <h2>Why Is a Valuation Important?</h2>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;">
      <% const reasons = [
        { icon: 'fas fa-sync-alt', title: 'Refinancing', text: 'Lenders base the amount of their loans on the value of your property and usually allow you to borrow a maximum of 75% to 95% against your property. Knowing what your home is worth allows lenders to evaluate your equity.' },
        { icon: 'fas fa-tools', title: 'Home Improvements', text: 'If you are doing home improvement projects to increase the resale value, you want to make sure you are not pricing yourself out of the market. A valuation can show you how your home compares with others in the neighborhood.' },
        { icon: 'fas fa-credit-card', title: 'Qualifying for Credit', text: 'If you want to borrow cash against your home, getting a Home Equity Line of Credit (HELOC) can be a good option. To qualify, you must have a certain level of equity in your home. Most lenders require at least 20%.' },
        { icon: 'fas fa-calendar-alt', title: 'Planning', text: 'Though it\'s not a necessity, simply knowing the value of your home is good information to have. It will help you plan for the future and deal with unforeseen circumstances when you might be in a position that requires quick money or a quick relocation.' },
      ] %>
      <% reasons.forEach(r => { %>
      <div style="display:flex;gap:20px;align-items:flex-start;">
        <div style="width:48px;height:48px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="<%= r.icon %>" style="color:var(--navy);"></i>
        </div>
        <div>
          <h4 style="font-family:var(--font-body);font-weight:700;font-size:14px;color:var(--navy);margin-bottom:8px;letter-spacing:0.05em;text-transform:uppercase;"><%= r.title %></h4>
          <p style="font-size:13px;color:var(--text-mid);line-height:1.8;"><%= r.text %></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>

<script>
function startValuation() {
  const addr = document.getElementById('valuationAddress').value.trim();
  if (!addr) {
    document.getElementById('valuationAddress').focus();
    return;
  }
  alert('Thank you! Rajivan will prepare a customized valuation for: ' + addr + '\n\nPlease check your email shortly, or call +1 (647) 123-4567 to speak directly with Rajivan.');
}
document.getElementById('valuationAddress').addEventListener('keypress', e => {
  if (e.key === 'Enter') startValuation();
});
</script>
