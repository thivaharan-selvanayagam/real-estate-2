<script>
// Load featured listings dynamically
// Load featured listings dynamically with proper image URL structures
fetch('/api/listings?limit=3')
  .then(r => r.json())
  .then(data => {
    const container = document.getElementById('aboutListings');
    if (data.listings && data.listings.length > 0) {
      container.innerHTML = data.listings.slice(0, 3).map(l => {
        let img = l.images && l.images[0] ? l.images[0] : '/images/placeholder-home.jpg';
        
        if (img && !img.startsWith('http') && !img.startsWith('/')) {
          img = `https://cdn.repliers.io/${img}`;
        }
        
        const price = l.listPrice ? '$' + Number(l.listPrice).toLocaleString() : 'Price on Request';
        const addr = l.address ? `${l.address.streetNumber || ''} ${l.address.streetName || ''}, ${l.address.city || ''}` : '';
        
        return `<a href="/listings/${l.mlsNumber || l.listingId}" class="listing-card">
          <div class="listing-img-wrap"><img src="${img}" alt="${addr}" onerror="this.src='/images/placeholder-home.jpg'">
          <div class="listing-badge badge-sale">For Sale</div></div>
          <div class="listing-body"><div class="listing-price">${price}</div><div class="listing-address">${addr}</div></div></a>`;
      }).join('');
    }
  }).catch(() => {});
</script>
