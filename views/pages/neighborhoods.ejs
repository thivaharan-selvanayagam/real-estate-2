<%- include('../partials/header') %>

<div class="page-hero">
  <div class="page-hero-bg">
    <img src="https://images.unsplash.com/photo-1449844908441-8829872d2607?w=1400&q=80" alt="Greater Toronto Area Neighborhoods">
  </div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content"><h1>Neighborhoods</h1></div>
</div>

<section class="section bg-cream">
  <div class="container">
    <div class="section-header text-center mb-48">
      <span class="section-label">Where We Serve</span>
      <h2>Areas of Expertise</h2>
    </div>
    
    <div class="neighborhoods-grid">
      <% 
        // Migrated to high-end Greater Toronto and Durham/York Region target clusters
        const neighborhoods = [
          { 
            name: 'Toronto', 
            desc: `Canada's dynamic financial and cultural heart. A magnificent tapestry of iconic high-rises, distinct historic communities, and top-tier luxury real estate options.`, 
            img: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=600&q=70' 
          },
          { 
            name: 'Markham', 
            desc: `A premier high-tech hub blending upscale heritage settings like Unionville with beautifully master-planned master-planned estate properties and top-ranking schools.`, 
            img: 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=600&q=70' 
          },
          { 
            name: 'Stouffville', 
            desc: `An enchanting community offering a gorgeous rural escape, rich conservation parklands, and expansive country homes just moments from urban amenities.`, 
            img: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=600&q=70' 
          },
          { 
            name: 'Pickering', 
            desc: `Breathtaking waterfront living along Lake Ontario featuring a smooth mix of thriving commercial centers, lakeside trails, and emerging residential spaces.`, 
            img: 'https://images.unsplash.com/photo-1513584684374-8bab748fbf90?w=600&q=70' 
          },
          { 
            name: 'Ajax', 
            desc: `A diverse, highly connected community famous for its untouched continuous natural waterfront, exceptional transit links, and family-oriented neighborhoods.`, 
            img: 'https://images.unsplash.com/photo-1600585154526-990dced4db0d?w=600&q=70' 
          },
          { 
            name: 'Oshawa', 
            desc: `The rapidly expanding industrial and educational anchor city of Durham Region, boasting great real estate choices and modern infrastructure upgrades.`, 
            img: 'https://images.unsplash.com/photo-1600566753376-12c8ab7fb75b?w=600&q=70' 
          },
          { 
            name: 'Mississauga', 
            desc: `A massive modern metropolis offering custom executive lakeside properties in Port Credit, a dramatic skyline, and central financial sectors.`, 
            img: 'https://images.unsplash.com/photo-1600573472591-ee6b68d14c68?w=600&q=70' 
          },
          { 
            name: 'Brampton', 
            desc: `One of Canada's fastest-growing residential markets, distinguished by its robust civic infrastructure, beautiful parks, and active layout choices.`, 
            img: 'https://images.unsplash.com/photo-1602941525421-8f8b81d3edbb?w=600&q=70' 
          },
          { 
            name: 'Vaughan', 
            desc: `A highly prestigious landscape containing affluent pockets like Woodbridge, fine custom architectural estates, and vibrant entertainment destinations.`, 
            img: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=600&q=70' 
          }
        ]; 
      %>
      
      <% neighborhoods.forEach(n => { %>
      <a href="/home-search?q=<%= encodeURIComponent(n.name) %>" class="neighborhood-card" style="position:relative;cursor:pointer;border-radius:4px;overflow:hidden;display:block;">
        <img src="<%= n.img %>" alt="<%= n.name %>" style="width:100%;height:200px;object-fit:cover;transition:transform 0.4s ease;">
        <div class="neighborhood-overlay" style="position:absolute;inset:0;background:linear-gradient(to top,rgba(13,27,42,0.85) 0%,rgba(13,27,42,0.2) 100%);display:flex;flex-direction:column;justify-content:flex-end;padding:20px;">
          <h3 style="color:var(--white);font-size:20px;margin-bottom:4px;"><%= n.name %></h3>
          <p style="color:rgba(255,255,255,0.75);font-size:12px;line-height:1.5;"><%= n.desc %></p>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <div>
        <span class="section-label">Browse Available Homes</span>
        <h2>Start Your Property Search</h2>
      </div>
      <a href="/home-search" class="btn btn-primary btn-lg">Browse Homes</a>
    </div>
  </div>
</section>

<section class="work-with" style="background-image:url('https://images.unsplash.com/photo-1570168007204-dfb528c6958f?w=1400&q=70');">
  <div class="work-with-overlay"></div>
  <div class="container work-with-content">
    <h2>Work With Rajivan</h2>
    <p>With a passion for real estate and years of experience in sales and negotiation, Rajivan ensures that every client gets top-tier service. Call him today to see how he can help you navigate the Greater Toronto Area real estate market with confidence.</p>
    <a href="/contact" class="btn btn-primary btn-lg mt-32">Let's Connect</a>
  </div>
</section>

<%- include('../partials/footer') %>