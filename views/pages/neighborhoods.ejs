<%- include('../partials/header') %>

<div class="page-hero">
  <div class="page-hero-bg">
    <img src="https://images.unsplash.com/photo-1449844908441-8829872d2607?w=1400&q=80" alt="Neighborhoods">
  </div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content"><h1>Neighborhoods</h1></div>
</div>

<section class="section bg-cream">
  <div class="container">
    <div class="section-header text-center mb-48">
      <span class="section-label">Where We Serve</span>
      <h2>Areas of Expertise</h2>
    </div>
    <div class="neighborhoods-grid">
      <% const neighborhoods = [
        { name: 'Bastrop', desc: 'Charming historic downtown, scenic river views, and a tight-knit community. Ideal for families and retirees.', img: 'https://images.unsplash.com/photo-1570168007204-dfb528c6958f?w=600&q=70' },
        { name: 'Bastrop County', desc: 'Wide-open spaces, ranch properties, and peaceful rural living just outside the city.', img: 'https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?w=600&q=70' },
        { name: 'Smithville', desc: 'A quaint, artsy community known for its beautiful downtown and friendly neighbors.', img: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=600&q=70' },
        { name: 'Elgin', desc: 'Fast-growing area with affordable housing and easy access to Austin and surrounding areas.', img: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&q=70' },
        { name: 'Del Valle', desc: 'Suburban community with proximity to Austin-Bergstrom Airport and major employment corridors.', img: 'https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=600&q=70' },
        { name: 'Austin', desc: 'The vibrant capital of Texas — world-class dining, culture, tech hub, and live music capital.', img: 'https://images.unsplash.com/photo-1531218150217-54595bc2b934?w=600&q=70' },
        { name: 'Cedar Creek', desc: 'Peaceful rural community with large lots, mature trees, and easy access to Bastrop.', img: 'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&q=70' },
        { name: 'McDade', desc: 'Small-town charm with agricultural roots and growing residential development.', img: 'https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=600&q=70' },
        { name: 'Lockhart', desc: 'The BBQ Capital of Texas, with a welcoming community and affordable real estate options.', img: 'https://images.unsplash.com/photo-1416339684178-3a239570f315?w=600&q=70' },
      ] %>
      <% neighborhoods.forEach(n => { %>
      <a href="/home-search?q=<%= encodeURIComponent(n.name) %>" class="neighborhood-card" style="position:relative;cursor:pointer;border-radius:4px;overflow:hidden;display:block;">
        <img src="<%= n.img %>" alt="<%= n.name %>" style="width:100%;height:200px;object-fit:cover;transition:transform 0.4s ease;">
        <div class="neighborhood-overlay" style="position:absolute;inset:0;background:linear-gradient(to top,rgba(13,27,42,0.85) 0%,rgba(13,27,42,0.2) 100%);display:flex;flex-direction:column;justify-content:flex-end;padding:20px;">
          <h3 style="color:var(--white);font-size:20px;margin-bottom:4px;"><%= n.name %></h3>
          <p style="color:rgba(255,255,255,0.75);font-size:12px;line-height:1.5;"><%= n.desc %></p>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <div>
        <span class="section-label">Browse Available Homes</span>
        <h2>Start Your Property Search</h2>
      </div>
      <a href="/home-search" class="btn btn-primary btn-lg">Browse Homes</a>
    </div>
  </div>
</section>

<section class="work-with" style="background-image:url('https://images.unsplash.com/photo-1570168007204-dfb528c6958f?w=1400&q=70');">
  <div class="work-with-overlay"></div>
  <div class="container work-with-content">
    <h2>Work With Rajivan</h2>
    <p>With a passion for real estate and years of experience in sales and negotiation, Rajivan ensures that every client gets top-tier service. Call him today to see how he can help you navigate the Bastrop real estate market with confidence.</p>
    <a href="/contact" class="btn btn-primary btn-lg mt-32">Let's Connect</a>
  </div>
</section>

<%- include('../partials/footer') %>
