<%- include('../partials/header') %>

<style>
  /* ==========================================================================
     HERO BACKGROUND VIDEO STYLING
     Ensures smooth, full-cover playback without affecting text readability
     ========================================================================== */
  .hero-bg video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.95; /* Matches your luxury branding contrast rules */
    position: absolute;
    inset: 0;
  }

  /* Split Promo Banner Elements */
  .split-promo-section {
    background: var(--cream);
    padding: 120px 0 0 0;
    position: relative;
    z-index: 5;
    width: 100%;
  }
  .split-banner-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    margin-top: 56px;
  }
  .split-panel {
    position: relative;
    height: 560px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    text-decoration: none;
    color: var(--white);
  }
  .split-panel-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 1;
  }
  .split-panel:hover .split-panel-bg {
    transform: scale(1.04);
  }
  .split-panel-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.6) 100%);
    z-index: 2;
    transition: var(--transition);
  }
  .split-panel:hover .split-panel-overlay {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.7) 100%);
  }
  .split-panel-content {
    position: relative;
    z-index: 3;
    padding: 0 40px;
    width: 100%;
    max-width: 560px;
  }
  .split-panel-content h3 {
    font-family: var(--font-heading);
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 400;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .split-panel-content p {
    font-family: var(--font-body);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 400;
    margin-bottom: 32px;
    letter-spacing: 0.02em;
  }
  .split-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #e9decb;
    color: var(--navy);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 14px 44px;
    border-radius: 2px;
    transition: var(--transition);
  }
  .split-panel:hover .split-btn {
    background: var(--white);
    color: var(--navy);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  /* LUXURY NAVIGATION TRIPLE CARD GRID (bg-navy) */
  .services-banner-section {
    background: var(--navy);
    padding: 100px 0;
    width: 100%;
  }
  .services-banner-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .service-banner-card {
    position: relative;
    height: 500px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    text-decoration: none;
    padding-bottom: 48px;
  }
  .service-banner-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 1;
  }
  .service-banner-card:hover .service-banner-bg {
    transform: scale(1.05);
  }
  .service-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 27, 42, 0.85) 0%, rgba(13, 27, 42, 0.2) 60%, transparent 100%);
    z-index: 2;
  }
  .service-banner-card h3 {
    position: relative;
    z-index: 3;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
    transition: var(--transition);
  }
  .service-banner-card:hover h3 {
    color: var(--gold-light);
  }

  /* Responsive Control Adjustments */
  @media (max-width: 900px) {
    .split-promo-section {
      padding-top: 80px;
    }
    .split-banner-grid {
      grid-template-columns: 1fr !important;
    }
    .split-panel {
      height: 460px !important;
    }
    .services-banner-section {
      padding: 64px 0;
    }
    .services-banner-grid {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }
    .service-banner-card {
      height: 400px !important;
    }
  }
</style>

