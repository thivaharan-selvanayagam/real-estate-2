<%- include('../partials/footer') %>

<script>
function doHeroSearch() {
  const q = document.getElementById('heroSearch').value;
  const type = document.getElementById('heroType').value;
  window.location.href = `/home-search?q=${encodeURIComponent(q)}&type=${type}`;
}

// Global scope initialization parameters for query handling
let debounceTimer;
const searchInput = document.getElementById('heroSearch');
const suggestionsBox = document.getElementById('searchSuggestions');

searchInput.addEventListener('input', () => {
  clearTimeout(debounceTimer);
  const query = searchInput.value.trim();

  if (query.length < 2) {
    suggestionsBox.style.display = 'none';
    return;
  }

  // Debounce network connection calls to save bandwidth limits
  debounceTimer = setTimeout(() => {
    fetch(`/api/listings?q=${encodeURIComponent(query)}&limit=15`)
      .then(res => res.json())
      .then(data => {
        if (!data.listings || data.listings.length === 0) {
          suggestionsBox.style.display = 'none';
          return;
        }

        // Establish data indexing clusters
        const matchMLS = new Set();
        const matchAddresses = new Set();
        const matchNeighborhoods = new Set();
        const matchCities = new Set();
        const matchZips = new Set();

        data.listings.forEach(item => {
          const lowerQuery = query.toLowerCase();
          
          // Index MLS matches
          const mls = item.mlsNumber || item.listingId;
          if (mls && mls.toLowerCase().includes(lowerQuery)) matchMLS.add(mls);

          if (item.address) {
            const city = item.address.city;
            const hood = item.address.neighborhood;
            const zip = item.address.zip;
            
            // Index location fields
            if (city && city.toLowerCase().includes(lowerQuery)) matchCities.add(city);
            if (hood && hood.toLowerCase().includes(lowerQuery)) matchNeighborhoods.add(hood);
            if (zip && zip.toLowerCase().includes(lowerQuery)) matchZips.add(zip);

            // Index absolute address lines
            const street = [item.address.streetNumber, item.address.streetName].filter(Boolean).join(' ');
            if (street && street.toLowerCase().includes(lowerQuery)) {
              matchAddresses.add(`${street}, ${city || ''}`);
            }
          }
        });

        // Compile HTML strings
        let htmlOutput = '';

        if (matchMLS.size > 0) {
          htmlOutput += `<div class="suggestion-group-title">MLS Numbers</div>`;
          matchMLS.forEach(val => {
            htmlOutput += `<div class="suggestion-item" onclick="selectSuggestion('${val}', 'mls')"><i class="fas fa-hashtag"></i><span>${val}</span></div>`;
          });
        }
        if (matchAddresses.size > 0) {
          htmlOutput += `<div class="suggestion-group-title">Addresses</div>`;
          matchAddresses.forEach(val => {
            htmlOutput += `<div class="suggestion-item" onclick="selectSuggestion('${val}', 'txt')"><i class="fas fa-map-marker-alt"></i><span>${val}</span></div>`;
          });
        }
        if (matchNeighborhoods.size > 0) {
          htmlOutput += `<div class="suggestion-group-title">Neighborhoods</div>`;
          matchNeighborhoods.forEach(val => {
            htmlOutput += `<div class="suggestion-item" onclick="selectSuggestion('${val}', 'txt')"><i class="fas fa-tree"></i><span>${val}</span></div>`;
          });
        }
        if (matchCities.size > 0) {
          htmlOutput += `<div class="suggestion-group-title">Cities</div>`;
          matchCities.forEach(val => {
            htmlOutput += `<div class="suggestion-item" onclick="selectSuggestion('${val}', 'txt')"><i class="fas fa-city"></i><span>${val}</span></div>`;
          });
        }
        if (matchZips.size > 0) {
          htmlOutput += `<div class="suggestion-group-title">Zip Codes</div>`;
          matchZips.forEach(val => {
            htmlOutput += `<div class="suggestion-item" onclick="selectSuggestion('${val}', 'txt')"><i class="fas fa-mail-bulk"></i><span>${val}</span></div>`;
          });
        }

        if (htmlOutput) {
          suggestionsBox.innerHTML = htmlOutput;
          suggestionsBox.style.display = 'block';
        } else {
          suggestionsBox.style.display = 'none';
        }
      })
      .catch(() => {
        suggestionsBox.style.display = 'none';
      });
  }, 300);
});

// Dropdown click processing router handler
function selectSuggestion(value, targetType) {
  suggestionsBox.style.display = 'none';
  if (targetType === 'mls') {
    // Navigate straight to detail view if they select an explicit MLS token
    window.location.href = `/listings/${value}`;
  } else {
    searchInput.value = value;
    doHeroSearch();
  }
}

// Dismiss suggestion modal container if client clicks outside focus
document.addEventListener('click', (e) => {
  if (!e.target.closest('.search-input-container')) {
    suggestionsBox.style.display = 'none';
  }
});

searchInput.addEventListener('keypress', e => {
  if (e.key === 'Enter') {
    suggestionsBox.style.display = 'none';
    doHeroSearch();
  }
});
</script>