<%- include('../partials/header') %>

<section class="hero">
  <div class="hero-bg">
    <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1600&q=80" alt="Luxury Home">
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content fade-up">
    <span class="section-label">Royal Lepage Associates Realty</span>
    <h1>Rajivan Varatharajah</h1>
    <p class="hero-sub">Expert Buyer, Seller, and Investment Services</p>
    <p>Serving Durham, York and Greater Toronto Area</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <a href="/home-search" class="btn btn-primary btn-lg">Search Homes</a>
      <a href="/home-valuation" class="btn btn-outline-light btn-lg">Home Valuation</a>
    </div>
  </div>
  <div class="hero-search-bar">
    <div class="container">
      <div class="quick-search-bar" style="position: relative; overflow: visible;">
        
        <div class="search-input-container">
          <input type="text" id="heroSearch" placeholder="City, neighborhood, ZIP, or MLS#..." class="quick-search-input" autocomplete="off">
          <div id="searchSuggestions" class="search-suggestions-box"></div>
        </div>

        <select class="quick-search-select" id="heroType">
          <option value="">All Types</option>
          <option value="residential">Residential</option>
          <option value="condo">Condo</option>
          <option value="land">Land</option>
        </select>
        <button class="btn btn-primary" onclick="doHeroSearch()">
